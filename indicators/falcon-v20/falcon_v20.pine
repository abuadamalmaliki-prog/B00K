//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  FALCON V20 · TREND-SWEEP SCANNER  (TradingView only · execute by hand in MT5)
//
//  Strategy (winner of a 5-team comparison of ~40 techniques and combinations,
//  the only one that stayed positive after costs on unseen instruments):
//    H4 EMA 9/21 cross, taken only within 6 bars after a liquidity-sweep setup
//    in the same direction. Stop 1.5 x ATR(14), target 2R.
//    Sweep setup = close back beyond a swept swing or previous-day high/low,
//    confirmed by a pin bar or a close beyond the last 3 bars, RSI(14) not
//    stretched, sweep stop <= 100 pips.
//
//  One chart, one alert: it scans up to 11 symbols on H4 and every alert
//  carries the MT5 order to type (side, lots, stop, target).
//
//  Sizing and the probability meter come from an exact dynamic programme over
//  the strategy's net trade outcomes: the risk that maximises P(reach goal by
//  the deadline) for the current balance and the trades still available.
//
//  Non-repainting: every value comes from the last CLOSED H4 bar
//  ([1] with lookahead_on). Signals appear at the open of the next H4 bar.
// ═════════════════════════════════════════════════════════════════════════════
indicator("Falcon V20 Trend-Sweep Scanner", shorttitle = "Falcon V20", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─── ① Plan ──────────────────────────────────────────────────────────────────
const string G_PLAN = "① Plan"
planStart = input.time(timestamp("Asia/Kuwait", 2026, 10, 2, 0, 0), "Plan start", group = G_PLAN)
planEnd   = input.time(timestamp("Asia/Kuwait", 2026, 11, 1, 0, 0), "Deadline", group = G_PLAN)
startBal  = input.float(30, "Start balance ($)", minval = 1, group = G_PLAN)
balance   = input.float(30, "Current balance ($)", minval = 0.01, group = G_PLAN, tooltip = "Update after every closed trade (MT5 → History). Lot sizes and probabilities are computed from it.")
goal      = input.float(5000, "Goal ($)", minval = 1, group = G_PLAN)
aimMode   = input.string("Goal", "Size trades to maximise P of", options = ["Goal", "Next milestone"], group = G_PLAN, tooltip = "Goal: the risk that maximises the probability of reaching the goal by the deadline. Next milestone: the risk that maximises the probability of the next rung ($60, $150, $500, $1,500, goal).")
tradesDay = input.float(0.33, "Trade opportunities per trading day", minval = 0.05, step = 0.01, group = G_PLAN, tooltip = "Research: a median of 7 trades per 21 trading days when holding one position at a time across 11 symbols.")

// ─── ② Account (JustMarkets Standard) ────────────────────────────────────────
const string G_ACC = "② Account"
leverage   = input.int(3000, "Leverage 1:", minval = 1, group = G_ACC, inline = "lev")
safety     = input.float(3.0, "margin safety ×", minval = 1, step = 0.5, group = G_ACC, inline = "lev", tooltip = "Lots are capped as if margin were this many times higher, so a leverage cut around news, weekends or bigger balances cannot stop you out before your stop.")
stopOut    = input.float(50, "Stop-out %", minval = 0, maxval = 100, group = G_ACC)
lotStep    = input.float(0.01, "Lot step / minimum", minval = 0.001, step = 0.01, group = G_ACC)
swapNight  = input.float(0.5, "Swap cost per night (pips)", minval = 0, step = 0.1, group = G_ACC, tooltip = "Used for the scorecard only. Charged at each 17:00 New York rollover, Wednesday x3.")


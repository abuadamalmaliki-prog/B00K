// ─── Plan state ──────────────────────────────────────────────────────────────
f_tradingDaysLeft(int fromT, int toT) =>
    int n = 0
    for k = 0 to 70
        int d = fromT + k * 86400000
        if d >= toT
            break
        // a trading day runs 17:00-17:00 New York and is named after the date it ends on
        int dw = dayofweek(d + 7 * 3600000, "America/New_York")
        if dw != dayofweek.saturday and dw != dayofweek.sunday
            n += 1
    n

nowT      = math.max(timenow, planStart)
daysLeft  = timenow >= planEnd ? 0 : f_tradingDaysLeft(nowT, planEnd)
daysTotal = f_tradingDaysLeft(planStart, planEnd)
tradesLeft = daysLeft <= 0 ? 0 : math.max(1, math.min(TAB_N, int(math.round(daysLeft * tradesDay))))

// Milestones: the ladder below the goal, then the goal.
f_nextMilestone(float bal, float g) =>
    float m = g
    if bal < 60 and 60 < g
        m := 60
    else if bal < 150 and 150 < g
        m := 150
    else if bal < 500 and 500 < g
        m := 500
    else if bal < 1500 and 1500 < g
        m := 1500
    m

pGoal  = f_prob(balance, goal, tradesLeft)
fGoal  = f_frac(balance, goal, tradesLeft)
nextM  = f_nextMilestone(balance, goal)
pNext  = f_prob(balance, nextM, tradesLeft)
// When the goal cannot be reached with the trades left (optimal risk 0), size for the next milestone instead.
useM   = balance < goal and nextM < goal and (aimMode == "Next milestone" or fGoal <= 0)
fUse   = useM ? f_frac(balance, nextM, tradesLeft) : fGoal
aimTxt = useM ? "next milestone $" + str.tostring(nextM, "#") : "goal $" + str.tostring(goal, "#")

// Lots for a signal: risk fUse × balance, capped so the stop fills before stop-out.
f_lots(float riskPips, float pipVal, float marginLot) =>
    float riskUsd = fUse * balance
    float perLot = riskPips * pipVal + stopOut / 100 * marginLot
    float capL = perLot > 0 ? math.floor(balance / perLot / lotStep + 1e-9) * lotStep : 0.0
    float want = riskPips * pipVal > 0 ? math.floor(riskUsd / (riskPips * pipVal) / lotStep + 1e-9) * lotStep : 0.0
    float lots = math.min(want, capL)
    if lots < lotStep and fUse > 0 and capL >= lotStep
        lots := lotStep
    lots < lotStep - 1e-9 ? 0.0 : lots

f_px(float p, float pip) =>
    str.tostring(p, pip >= 0.01 ? "0.000" : "0.00000")

// Compose the MT5 ticket for one symbol's new signal ("" when none).
f_ticket(bool on, string tk, int d, float c, float sl, float tp, float rk, int t, float pip, simple float contract, float fx) =>
    string out = ""
    if on and d != 0 and t != t[1] and not na(fx) and fx > 0
        float pipVal = contract * pip * fx
        float marginLot = contract * c * fx / leverage * safety
        float lots = f_lots(rk, pipVal, marginLot)
        float riskUsd = lots * rk * pipVal
        float winUsd = lots * (math.abs(tp - c) / pip) * pipVal
        out := (d == 1 ? "BUY " : "SELL ") + tk + " @≈" + f_px(c, pip) + " | SL " + f_px(sl, pip) + " (" + str.tostring(math.abs(c - sl) / pip, "0.0") + "p) | TP " + f_px(tp, pip) + " (" + str.tostring(math.abs(tp - c) / pip, "0.0") + "p) | " + (lots > 0 ? str.tostring(lots, "0.00") + " lots, risk $" + str.tostring(riskUsd, "0.00") + ", win ≈ $" + str.tostring(winUsd, "0.00") : "lots: below minimum")
    out

tx01 = f_ticket(o01, tk01, d01, c01, sl01, tp01, rk01, t01, pp01, f_contract(tk01), fx01)
tx02 = f_ticket(o02, tk02, d02, c02, sl02, tp02, rk02, t02, pp02, f_contract(tk02), fx02)
tx03 = f_ticket(o03, tk03, d03, c03, sl03, tp03, rk03, t03, pp03, f_contract(tk03), fx03)
tx04 = f_ticket(o04, tk04, d04, c04, sl04, tp04, rk04, t04, pp04, f_contract(tk04), fx04)
tx05 = f_ticket(o05, tk05, d05, c05, sl05, tp05, rk05, t05, pp05, f_contract(tk05), fx05)
tx06 = f_ticket(o06, tk06, d06, c06, sl06, tp06, rk06, t06, pp06, f_contract(tk06), fx06)
tx07 = f_ticket(o07, tk07, d07, c07, sl07, tp07, rk07, t07, pp07, f_contract(tk07), fx07)
tx08 = f_ticket(o08, tk08, d08, c08, sl08, tp08, rk08, t08, pp08, f_contract(tk08), fx08)
tx09 = f_ticket(o09, tk09, d09, c09, sl09, tp09, rk09, t09, pp09, f_contract(tk09), fx09)
tx10 = f_ticket(o10, tk10, d10, c10, sl10, tp10, rk10, t10, pp10, f_contract(tk10), fx10)
tx11 = f_ticket(o11, tk11, d11, c11, sl11, tp11, rk11, t11, pp11, f_contract(tk11), fx11)

f_add(string a, string b) =>
    b == "" ? a : a == "" ? b : a + "\n" + b

string tickets = ""
tickets := f_add(tickets, tx01)
tickets := f_add(tickets, tx02)
tickets := f_add(tickets, tx03)
tickets := f_add(tickets, tx04)
tickets := f_add(tickets, tx05)
tickets := f_add(tickets, tx06)
tickets := f_add(tickets, tx07)
tickets := f_add(tickets, tx08)
tickets := f_add(tickets, tx09)
tickets := f_add(tickets, tx10)
tickets := f_add(tickets, tx11)

// ─── Alert: one message for every new signal on this H4 close ───────────────
if tickets != ""
    alert("Falcon V20 · risk " + str.tostring(fUse * 100, "0") + "% toward " + aimTxt + " · P(goal) " + str.tostring(pGoal * 100, "0.00") + "%\n" + tickets + "\nOne position at a time. Type SL and TP in MT5 as prices or by the pip distances shown.", alert.freq_once_per_bar)

// Remember the most recent signals for the panel.
var array<string> recent = array.new<string>()
if tickets != ""
    array.unshift(recent, str.format("{0,date,dd MMM HH:mm}", timenow) + " · " + tickets)
    while array.size(recent) > 3
        array.pop(recent)

// ─── Chart markers for the chart's own symbol (keep the chart on H4) ─────────
pipC = f_pip(syminfo.ticker)
[dC, cC, slC, tpC, rkC, tC, nC, wC, rC] = request.security(syminfo.tickerid, "240", f_engine(pipC, 1.5, swapNight), lookahead = barmerge.lookahead_on)
newC = dC != 0 and tC != tC[1] and timeframe.period == "240"
plotshape(newC and dC == 1, "Buy", shape.labelup, location.belowbar, color.new(#00C853, 0), offset = -1, text = "BUY", textcolor = color.white, size = size.small)
plotshape(newC and dC == -1, "Sell", shape.labeldown, location.abovebar, color.new(#FF1744, 0), offset = -1, text = "SELL", textcolor = color.white, size = size.small)
if newC
    line.new(bar_index - 1, slC, bar_index + 6, slC, color = color.new(#FF1744, 20), style = line.style_dashed)
    line.new(bar_index - 1, tpC, bar_index + 6, tpC, color = color.new(#00C853, 20), style = line.style_dashed)

// ─── Panel ───────────────────────────────────────────────────────────────────
f_on(bool o, int v) =>
    o ? nz(v) : 0
f_onf(bool o, float v) =>
    o ? nz(v) : 0.0
totN = f_on(o01, n01) + f_on(o02, n02) + f_on(o03, n03) + f_on(o04, n04) + f_on(o05, n05) + f_on(o06, n06) + f_on(o07, n07) + f_on(o08, n08) + f_on(o09, n09) + f_on(o10, n10) + f_on(o11, n11)
totW = f_on(o01, w01) + f_on(o02, w02) + f_on(o03, w03) + f_on(o04, w04) + f_on(o05, w05) + f_on(o06, w06) + f_on(o07, w07) + f_on(o08, w08) + f_on(o09, w09) + f_on(o10, w10) + f_on(o11, w11)
totR = f_onf(o01, r01) + f_onf(o02, r02) + f_onf(o03, r03) + f_onf(o04, r04) + f_onf(o05, r05) + f_onf(o06, r06) + f_onf(o07, r07) + f_onf(o08, r08) + f_onf(o09, r09) + f_onf(o10, r10) + f_onf(o11, r11)

var table dash = na
if barstate.isfirst
    string pos = dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : dashPos == "Bottom Left" ? position.bottom_left : position.top_right
    dash := table.new(pos, 2, 12, bgcolor = #0D1117F2, frame_color = #30363D, frame_width = 1, border_color = #30363D, border_width = 1)
    table.merge_cells(dash, 0, 0, 1, 0)
    table.merge_cells(dash, 0, 9, 1, 9)
    table.merge_cells(dash, 0, 10, 1, 10)
    table.merge_cells(dash, 0, 11, 1, 11)

f_row(int r, string k, string v, color c, string sz) =>
    table.cell(dash, 0, r, k, text_color = #C9D1D9, text_halign = text.align_left, text_size = sz)
    table.cell(dash, 1, r, v, text_color = c, text_halign = text.align_right, text_size = sz)

if barstate.islast
    string sz = dashSize == "Tiny" ? size.tiny : dashSize == "Normal" ? size.normal : size.small
    int dayNo = timenow < planStart ? 0 : daysTotal - daysLeft + 1
    string phase = timenow < planStart ? "starts " + str.format("{0,date,dd MMM}", planStart) : timenow >= planEnd ? "deadline passed" : "day " + str.tostring(dayNo) + " of " + str.tostring(daysTotal)
    table.cell(dash, 0, 0, "FALCON V20 · TREND-SWEEP", text_color = color.white, bgcolor = #1F6FEB, text_size = sz)
    f_row(1, "Plan", phase + " · " + str.tostring(daysLeft) + " days left", #C9D1D9, sz)
    f_row(2, "Balance → goal", "$" + str.tostring(balance, "0.00") + " → $" + str.tostring(goal, "#"), #C9D1D9, sz)
    f_row(3, "P(goal by deadline)", str.tostring(pGoal * 100, "0.00") + "%", pGoal >= 0.5 ? #00C853 : #FFB300, sz)
    f_row(4, "P(next $" + str.tostring(nextM, "#") + ")", str.tostring(pNext * 100, "0.0") + "%", pNext >= 0.5 ? #00C853 : #FFB300, sz)
    f_row(5, "Next trade risk", str.tostring(fUse * 100, "0") + "% = $" + str.tostring(fUse * balance, "0.00") + " (" + aimTxt + ")", #58A6FF, sz)
    f_row(6, "Trades left (est.)", str.tostring(tradesLeft), #C9D1D9, sz)
    f_row(7, "Scanner history", str.tostring(totN) + " trades · win " + (totN > 0 ? str.tostring(100.0 * totW / totN, "0.0") : "—") + "% · " + (totN > 0 ? str.tostring(totR / totN, "+0.000;-0.000") : "—") + "R/trade", totR >= 0 ? #00C853 : #FF1744, sz)
    f_row(8, "Chart", timeframe.period == "240" ? "H4 ✓" : "switch to H4 for markers", timeframe.period == "240" ? #00C853 : #FFB300, sz)
    table.cell(dash, 0, 9, array.size(recent) > 0 ? "Last: " + array.get(recent, 0) : "No new signal since the chart loaded", text_color = #C9D1D9, text_halign = text.align_left, text_size = size.tiny)
    table.cell(dash, 0, 10, "Rules: one position at a time · SL and TP set when you open · update balance after every close", text_color = #9E9E9E, text_size = size.tiny)
    table.cell(dash, 0, 11, "Scorecard net of spread + swap · probabilities from 2.7 years of research", text_color = #9E9E9E, text_size = size.tiny)

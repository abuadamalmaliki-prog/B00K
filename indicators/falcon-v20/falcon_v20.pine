166, 0.00196, 0.00232, 0.00274, 0.00324, 0.00382, 0.00452, 0.00534, 0.00631, 0.00745, 0.00880, 0.01040, 0.01228, 0.01450, 0.01713, 0.02023, 0.02389, 0.02821, 0.03331, 0.03933, 0.04644, 0.05482, 0.06468, 0.07630, 0.08997, 0.10609, 0.12506, 0.14742, 0.17377, 0.20466, 0.24088, 0.28334, 0.33316, 0.39161, 0.45967, 0.53907, 0.63136, 0.73811, 0.86080, 1.00000)

// ─── Helpers ─────────────────────────────────────────────────────────────────
f_tk(simple string s) =>
    str.substring(s, str.pos(s, ":") + 1)

f_pip(simple string tk) =>
    str.contains(tk, "XAU") ? 0.1 : str.contains(tk, "XAG") ? 0.01 : str.endswith(tk, "JPY") ? 0.01 : 0.0001

f_contract(simple string tk) =>
    str.contains(tk, "XAU") ? 100.0 : str.contains(tk, "XAG") ? 5000.0 : 100000.0

f_quote(simple string tk) =>
    str.substring(tk, str.length(tk) - 3)

f_col(float x) =>
    float u = (math.log(x) - math.log(0.001)) / (0.0 - math.log(0.001)) * (TAB_X - 1)
    math.max(0.0, math.min(TAB_X - 1.0, u))

// Max probability of reaching `target` from `bal` with `n` trades left.
f_prob(float bal, float target, int n) =>
    float x = bal / target
    float p = 0.0
    if x >= 1
        p := 1.0
    else if n >= 1 and x >= 0.001
        int row = math.min(n, TAB_N) - 1
        float u = f_col(x)
        int j = int(math.floor(u))
        float a = u - j
        float v0 = array.get(P_TAB, row * TAB_X + j)
        float v1 = j + 1 < TAB_X ? array.get(P_TAB, row * TAB_X + j + 1) : 1.0
        p := v0 * (1 - a) + v1 * a
    p

// Optimal risk fraction toward `target` from `bal` with `n` trades left.
f_frac(float bal, float target, int n) =>
    float x = bal / target
    float f = 0.0
    if x < 1 and n >= 1 and x >= 0.001
        int row = math.min(n, TAB_N) - 1
        int j = int(math.round(f_col(x)))
        f := array.get(F_TAB, row * TAB_X + j)
    f

// Swap rollovers (17:00 New York weekdays, Wednesday x3) in (t0, t1].
f_roll(int t0, int t1) =>
    int n = 0
    int lastR = na
    for k = 0 to 6
        int dt = t1 - k * 86400000
        int r = timestamp("America/New_York", year(dt, "America/New_York"), month(dt, "America/New_York"), dayofmonth(dt, "America/New_York"), 17, 0)
        int dw = dayofweek(r, "America/New_York")
        if r > t0 and r <= t1 and (na(lastR) or r != lastR) and dw != dayofweek.saturday and dw != dayofweek.sunday
            n += dw == dayofweek.wednesday ? 3 : 1
        lastR := r
    n

// ─── Strategy engine (runs inside each symbol's H4 context) ──────────────────
// Mirrors research/v20_mirror.py line by line. Returns the LAST CLOSED bar's
// values: [signal dir, close, stop, target, stop pips, bar time, trades, wins, sum R].
f_engine(simple float pipS, simple float spr, simple float swp) =>
    // --- liquidity-sweep setup engine ---
    var float shP = na
    var int shB = -1
    var bool shBr = true
    var bool shSw = false
    var float slP = na
    var int slB = -1
    var bool slBr = true
    var bool slSw = false
    var int lastBull = -1000000
    var int lastBear = -1000000
    var int lastSetL = -1000000
    var int lastSetS = -1000000
    var int curDay = -1
    var float curH = na
    var float curL = na
    var float pdh = na
    var float pdl = na
    int i = bar_index
    int dayIdx = int(math.floor(time / 86400000))
    if dayIdx != curDay
        if curDay >= 0
            pdh := curH
            pdl := curL
        curDay := dayIdx
        curH := high
        curL := low
    else
        curH := math.max(curH, high)
        curL := math.min(curL, low)
    // swings: 5 bars left, 3 bars right, strict
    if i >= 8
        bool isH = true
        bool isL = true
        for k = 0 to 8
            if k != 3
                if high[k] >= high[3]
                    isH := false
                if low[k] <= low[3]
                    isL := false
        if isH
            shP := high[3]
            shB := i - 3
            shBr := false
            shSw := false
        if isL
            slP := low[3]
            slB := i - 3
            slBr := false
            slSw := false
    if shB >= 0 and not shBr and close > shP
        shBr := true
    if slB >= 0 and not slBr and close < slP
        slBr := true
    bool swL = slB >= 0 and not slBr and not slSw and low < slP and close > slP
    bool swH = shB >= 0 and not shBr and not shSw and high > shP and close < shP
    if swL
        slSw := true
    if swH
        shSw := true
    bool pdL = not na(pdl) and low < pdl and close > pdl
    bool pdH = not na(pdh) and high > pdh and close < pdh
    if swL or pdL
        lastBull := i
    if swH or pdH
        lastBear := i
    float r14 = ta.rsi(close, 14)
    float hh = ta.highest(high, 3)[1]
    float ll = ta.lowest(low, 3)[1]
    float lo5 = ta.lowest(low, 5)
    float hi5 = ta.highest(high, 5)
    float body = math.abs(close - open)
    float rng = high - low
    float lw = math.min(open, close) - low
    float uw = high - math.max(open, close)
    bool pinL = rng > 0 and lw >= 2 * body and lw >= 0.5 * rng and high - close <= rng / 3.0
    bool pinS = rng > 0 and uw >= 2 * body and uw >= 0.5 * rng and close - low <= rng / 3.0
    bool mssL = close > hh and close > open
    bool mssS = close < ll and close < open
    bool ready = i >= 205 and not na(r14)
    bool longOk = i - lastBull <= 5 and (pinL or mssL) and r14 < 70
    bool shortOk = i - lastBear <= 5 and (pinS or mssS) and r14 > 30
    float rpL = math.max((close - (lo5 - 3 * pipS)) / pipS, 10)
    float rpS = math.max(((hi5 + 3 * pipS) - close) / pipS, 10)
    bool okL = ready and longOk and rpL <= 100 and 300 / rpL >= 3
    bool okS = ready and shortOk and rpS <= 100 and 300 / rpS >= 3
    if okL and not okS
        lastSetL := i
    if okS and not okL
        lastSetS := i
    // --- trend trigger: EMA 9/21 cross within 6 bars of a same-direction sweep setup ---
    float e9 = ta.ema(close, 9)
    float e21 = ta.ema(close, 21)
    float atr = ta.atr(14)
    bool xUp = ta.crossover(e9, e21)
    bool xDn = ta.crossunder(e9, e21)
    int sig = 0
    if i >= 250 and not na(atr) and atr > 0
        if xUp and lastSetL >= i - 6
            sig := 1
        else if xDn and lastSetS >= i - 6
            sig := -1
    float dist = 1.5 * atr
    float sigSL = sig != 0 ? close - sig * dist : na
    float sigTP = sig != 0 ? close + sig * 2.0 * dist : na
    float sigRisk = sig != 0 ? (dist + (sig == 1 ? spr * pipS : 0.0)) / pipS : na
    // --- scorecard: one position at a time, net of spread and swap ---
    var int tDir = 0
    var float tEntry = na
    var float tSL = na
    var float tTP = na
    var float tRisk = na
    var int tNights = 0
    var int nT = 0
    var int nW = 0
    var float sumR = 0.0
    float s = spr * pipS
    if tDir != 0
        tNights += f_roll(time[1], time)
        float px = na
        if tDir == 1
            if low <= tSL
                px := math.min(open, tSL)
            else if high >= tTP
                px := tTP
        else
            if high + s >= tSL
                px := math.max(open + s, tSL)
            else if low + s <= tTP
                px := tTP
        if not na(px)
            float pips = tDir * (px - tEntry) / pipS - swp * tNights
            nT += 1
            nW += pips > 0 ? 1 : 0
            sumR += pips / (tRisk / pipS)
            tDir := 0
    if tDir == 0 and sig != 0
        tDir := sig
        tEntry := sig == 1 ? close + s : close
        tSL := sigSL
        tTP := sigTP
        tRisk := math.abs(tEntry - tSL)
        tNights := 0
    [sig[1], close[1], sigSL[1], sigTP[1], sigRisk[1], time[1], nT[1], nW[1], sumR[1]]


// Quote-currency → USD conversion for pip values and margin.
fx01 = request.currency_rate(f_quote(tk01), "USD", ignore_invalid_currency = true)
fx02 = request.currency_rate(f_quote(tk02), "USD", ignore_invalid_currency = true)
fx03 = request.currency_rate(f_quote(tk03), "USD", ignore_invalid_currency = true)

//@version=6
// ❄ FROSTBITE v2 · XAUUSD M5 scalper
// Smooth line: 2-state Kalman filter of price (level + slope). Blue = rising, pink = falling.
// Signals: the two setups that held up in testing (612,880 one-minute gold bars, spread included):
//   ICICLE     EMA 34/50/200 trend pullback, 13:00–17:00 UTC.  TP1 1R, TP2 2R.
//   AVALANCHE  M15 close through yesterday's high/low with the H1 trend. TP1 1.5R, TP2 3R.
// Every signal: BUY/SELL, SL, TP1, TP2. Open 2 orders with the same SL: A → TP1, B → TP2.
// Decided on bar close; never repaints.
indicator("Frostbite XAUUSD M5", shorttitle = "Frostbite", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─── Inputs ───────────────────────────────────────────────────────────────────
const string MODE_MORE = "More signals (about 2.3 a day)"
const string MODE_FEW  = "Fewer, stronger (about 1.6 a day)"
mode     = input.string(MODE_MORE, "Signals", options = [MODE_MORE, MODE_FEW], tooltip = "Tested on gold, periods not used for tuning:\nMore: +0.05 × risk per trade on average.\nFewer: +0.09 × risk per trade on average.")
balance  = input.float(30, "Balance ($)", minval = 1)
riskPct  = input.float(2, "Risk per signal, both orders (%)", minval = 0.1, maxval = 100, step = 0.5)
spr      = input.float(0.30, "Spread ($)", minval = 0, step = 0.05)
showPast = input.bool(true, "Show past trades")

// ─── Constants (the tested settings) ─────────────────────────────────────────
const float ICE_T1 = 1.0
const float ICE_T2 = 2.0
const float AVA_T1 = 1.5
const float AVA_T2 = 3.0
const int   MAX_HOLD = 120        // minutes
const int   HOLD_BARS = 24        // 120 minutes of M5 bars
const float LOT_STEP = 0.01
const float CONTRACT = 100.0      // oz per lot
const float KF_QL = 0.001         // Kalman: level noise
const float KF_QS = 0.000001      // Kalman: slope noise
const float KF_R  = 1.0           // Kalman: measurement noise

const color C_BUY  = #29B6F6
const color C_SELL = #FF4081
const color C_SL   = #FF1744
const color C_TP   = #00E676
const color C_TXT  = #E0F7FA
const color C_BG   = #0B1B2B

firstOnly = mode == MODE_FEW
tkr       = syminfo.ticker
isGold    = str.contains(tkr, "XAUUSD") or str.contains(tkr, "GOLD")
isM5      = timeframe.in_seconds() == 300
active    = isGold and isM5

// ─── Clocks ───────────────────────────────────────────────────────────────────
f_nyMin(int t) =>
    hour(t, "America/New_York") * 60 + minute(t, "America/New_York")
tEnd       = time + timeframe.in_seconds() * 1000
nyMin      = f_nyMin(time)
nyMinClose = f_nyMin(tEnd)
tdayKey    = year(time + 7 * 3600000, "America/New_York") * 10000 + month(time + 7 * 3600000, "America/New_York") * 100 + dayofmonth(time + 7 * 3600000, "America/New_York")

// ─── Kalman filter (local linear trend): smooth line and its slope ───────────
var float kLv = na
var float kSl = 0.0
var float kP11 = 1.0
var float kP12 = 0.0
var float kP22 = 1.0
if na(kLv)
    kLv := close
else
    float x1  = kLv + kSl
    float p11 = kP11 + 2 * kP12 + kP22 + KF_QL
    float p12 = kP12 + kP22
    float p22 = kP22 + KF_QS
    float s   = p11 + KF_R
    float k1  = p11 / s
    float k2  = p12 / s
    float e   = close - x1
    kLv  := x1 + k1 * e
    kSl  := kSl + k2 * e
    kP22 := p22 - k2 * p12
    kP12 := (1 - k1) * p12
    kP11 := (1 - k1) * p11
color kCol = kSl >= 0 ? C_BUY : C_SELL
plot(active ? kLv : na, "Trend glow", color.new(kCol, 85), 8)
plot(active ? kLv : na, "Trend (Kalman)", kCol, 2)

// ─── M5 indicators ────────────────────────────────────────────────────────────
e34   = ta.ema(close, 34)
e50   = ta.ema(close, 50)
e200  = ta.ema(close, 200)
rsi14 = ta.rsi(close, 14)
atr5  = ta.atr(14)
[diP, diM, adx14] = ta.dmi(14, 14)

// ─── Yesterday's high/low (trading day = 17:00–17:00 New York) ───────────────
var float dayHi = na
var float dayLo = na
var float pdh = na
var float pdl = na
if tdayKey != nz(tdayKey[1], -1)
    pdh := dayHi
    pdl := dayLo
    dayHi := high
    dayLo := low
else
    dayHi := math.max(dayHi, high)
    dayLo := math.min(dayLo, low)

// ─── M15 bars and ATR(14) built from M5 ──────────────────────────────────────
var float m15h = na
var float m15l = na
var int   m15nym = 0
var int   m15day = 0
k15 = math.floor(time / 900000.0)
if k15 != nz(k15[1], -1)
    m15h := high
    m15l := low
    m15nym := nyMin
    m15day := tdayKey
else
    m15h := math.max(m15h, high)
    m15l := math.min(m15l, low)
m15Done = tEnd % 900000 == 0
var int   n15 = 0
var float acc15 = 0.0
var float atr15 = na
var float prev15c = na

// ─── H1 closes and EMA 50 built from M5 ──────────────────────────────────────
var int   n60 = 0
var float acc60 = 0.0
var float h1ema = na
var float h1trend = 0.0
if tEnd % 3600000 == 0
    n60 += 1
    if n60 < 50
        acc60 += close
    else if n60 == 50
        acc60 += close
        h1ema := acc60 / 50
    else
        h1ema := 2.0 / 51.0 * close + (1 - 2.0 / 51.0) * h1ema
    h1trend := na(h1ema) ? 0.0 : math.sign(close - h1ema)

// ─── ICICLE ───────────────────────────────────────────────────────────────────
utcH = hour(time, "UTC")
lo3  = ta.lowest(low, 3)
hi3  = ta.highest(high, 3)
iceL = e34 > e50 and e50 > e200 and close > e200 and lo3 <= e34 and close > open and close > high[1] and close > e34 and adx14 > 20 and rsi14 > 45 and rsi14 < 70
iceS = e34 < e50 and e50 < e200 and close < e200 and hi3 >= e34 and close < open and close < low[1] and close < e34 and adx14 > 20 and rsi14 < 55 and rsi14 > 30
int iceDir = utcH >= 13 and utcH < 17 and bar_index >= 5 and (iceL != iceS) ? (iceL ? 1 : -1) : 0
swLo = ta.lowest(low, 5) - 0.2 * atr5
swHi = ta.highest(high, 5) + 0.2 * atr5
float iceStop = iceDir == 1 ? math.min(math.max(close - swLo, 0.6 * atr5), 3 * atr5) : iceDir == -1 ? math.min(math.max(swHi - close, 0.6 * atr5), 3 * atr5) : na

// ─── AVALANCHE ────────────────────────────────────────────────────────────────
var int firstUpDay = -1
var int firstDnDay = -1
int   avaDir = 0
float avaStop = na
if m15Done
    float tr15 = na(prev15c) ? m15h - m15l : math.max(m15h - m15l, math.abs(m15h - prev15c), math.abs(m15l - prev15c))
    if not na(tr15)
        n15 += 1
        if n15 < 14
            acc15 += tr15
        else if n15 == 14
            acc15 += tr15
            atr15 := acc15 / 14
        else
            atr15 := (atr15 * 13 + tr15) / 14
    bool inWin = m15nym >= 18 * 60 or m15nym < 16 * 60
    if inWin and not na(pdh) and not na(prev15c) and not na(atr15)
        bool up = close > pdh and prev15c <= pdh and h1trend > 0
        bool dn = close < pdl and prev15c >= pdl and h1trend < 0
        if up and (not firstOnly or firstUpDay != m15day)
            avaDir := 1
            firstUpDay := m15day
        else if dn and (not firstOnly or firstDnDay != m15day)
            avaDir := -1
            firstDnDay := m15day
        avaStop := 1.5 * atr15
    prev15c := close

int   sigDir  = iceDir != 0 ? iceDir : avaDir
float sigStop = iceDir != 0 ? iceStop : avaStop
float sigT1   = iceDir != 0 ? ICE_T1 : AVA_T1
float sigT2   = iceDir != 0 ? ICE_T2 : AVA_T2

// ─── Lots: two orders; a buy's loss includes the spread ──────────────────────
f_lots(float stopDist, int dir) =>
    float lossPerLot = (stopDist + (dir == 1 ? spr : 0.0)) * CONTRACT
    float lots = math.floor(balance * riskPct / 100.0 / 2.0 / lossPerLot / LOT_STEP + 1e-9) * LOT_STEP
    bool minLot = lots < LOT_STEP
    lots := math.max(lots, LOT_STEP)
    [lots, 2.0 * lots * lossPerLot, minLot]

f_px(float p) =>
    str.tostring(p, "0.00")

// ─── Trade tracker (one at a time; same rules as the research engine) ────────
var int   tDir = 0
var bool  pend = false
var float tRef = na
var float tFill = na
var float tSL = na
var float tT1 = na
var float tT2 = na
var bool  leg1 = false
var bool  leg2 = false
var float r1 = 0.0
var float r2 = 0.0
var int   tEntryT = na
var int   tDay = 0
var bool  gotT1 = false
var bool  gotT2 = false
var bool  gotSL = false
var float tLots = na
var line  lnE = na
var line  lnSL = na
var line  lnT1 = na
var line  lnT2 = na
var label lbSL = na
var label lbT1 = na
var label lbT2 = na
var label lbSig = na
var label lbRes = na
var linefill fRisk = na
var linefill fGain = na

var int   nTr = 0
var int   nWin = 0
var float sumR = 0.0
var int   todayKey = 0
var int   todayN = 0

string evt = ""
bool cancelNow = false

f_clearTags() =>
    label.delete(lbSL)
    label.delete(lbT1)
    label.delete(lbT2)

// 1) enter at this bar's open
if pend
    pend := false
    bool stale = tDir == 1 ? (open <= tSL or open >= tT1) : (open + spr >= tSL or open + spr <= tT1)
    if stale
        tDir := 0
        evt := "Skip the last signal: price opened beyond a level"
        cancelNow := true
        line.delete(lnE)
        line.delete(lnSL)
        line.delete(lnT1)
        line.delete(lnT2)
        f_clearTags()
        label.set_text(lbSig, "skip")
        label.set_color(lbSig, color.new(#607D8B, 30))
    else
        tFill := tDir == 1 ? open + spr : open
        tEntryT := time
        tDay := tdayKey
        leg1 := true
        leg2 := true
        r1 := 0.0
        r2 := 0.0

// 2) manage the open trade: gap, stop first, then targets, then time exits
if tDir != 0 and not pend and (leg1 or leg2)
    float risk = math.abs(tRef - tSL)
    bool hadT1 = gotT1
    float bO = tDir == 1 ? open : open + spr
    float bH = tDir == 1 ? high : high + spr
    float bL = tDir == 1 ? low : low + spr
    bool slGap = tDir == 1 ? bO <= tSL : bO >= tSL
    bool slHit = tDir == 1 ? bL <= tSL : bH >= tSL
    bool t1Hit = tDir == 1 ? bH >= tT1 : bL <= tT1
    bool t2Hit = tDir == 1 ? bH >= tT2 : bL <= tT2
    float slPx = slGap ? bO : tSL
    if slGap or slHit
        if leg1
            r1 := tDir * (slPx - tFill) / risk
            leg1 := false
        if leg2
            r2 := tDir * (slPx - tFill) / risk
            leg2 := false
        gotSL := true
    if leg1 and t1Hit
        r1 := tDir * (tT1 - tFill) / risk
        leg1 := false
        gotT1 := true
    if leg2 and t2Hit
        r2 := tDir * (tT2 - tFill) / risk
        leg2 := false
        gotT2 := true
    if gotT1 and not hadT1 and leg2
        evt := "TP1 hit ✓ (order B still open, TP2 " + f_px(tT2) + ")"
    bool timeUp = tEnd - tEntryT >= MAX_HOLD * 60000
    bool flatNow = nyMinClose >= 16 * 60 + 50 and nyMin < 17 * 60
    bool newDay = tdayKey != tDay
    if (leg1 or leg2) and (timeUp or flatNow or newDay)
        float px = tDir == 1 ? close : close + spr
        if leg1
            r1 := tDir * (px - tFill) / risk
            leg1 := false
        if leg2
            r2 := tDir * (px - tFill) / risk
            leg2 := false
        evt := "Close now: 2-hour limit"
    if not leg1 and not leg2
        float rr = 0.5 * (r1 + r2)
        nTr += 1
        nWin += rr > 0 ? 1 : 0
        sumR += rr
        string res = gotT2 ? "TP2 ✓✓" : gotT1 ? "TP1 ✓" : gotSL ? "SL ✕" : "closed"
        if evt == ""
            evt := gotT2 ? "TP2 hit ✓✓" : gotSL and gotT1 ? "TP1 ✓, then order B stopped" : gotSL ? "SL hit ✕" : "Closed"
        if not na(lnSL)
            line.set_x2(lnE, bar_index)
            line.set_x2(lnSL, bar_index)
            line.set_x2(lnT1, bar_index)
            line.set_x2(lnT2, bar_index)
            f_clearTags()
            lbRes := label.new(bar_index, tDir == 1 ? (gotSL and not gotT1 ? low : high) : (gotSL and not gotT1 ? high : low), res, style = label.style_none, textcolor = gotT1 or gotT2 ? C_TP : C_SL, size = size.normal)
        tDir := 0

// 3) new signal on this closed bar
bool rollover = nyMinClose >= 16 * 60 + 50 and nyMinClose < 18 * 60
bool newSig = active and sigDir != 0 and tDir == 0 and not rollover and sigStop > 0 and barstate.isconfirmed
string sigTxt = ""
if newSig
    tDir := sigDir
    pend := true
    gotT1 := false
    gotT2 := false
    gotSL := false
    tRef := close
    tSL := close - sigDir * sigStop
    tT1 := close + sigDir * sigStop * sigT1
    tT2 := close + sigDir * sigStop * sigT2
    [lots, riskUsd, minLot] = f_lots(sigStop, sigDir)
    tLots := lots
    string side = sigDir == 1 ? "BUY" : "SELL"
    sigTxt := "❄ " + side + " XAUUSD " + f_px(close) + " | SL " + f_px(tSL) + " | TP1 " + f_px(tT1) + " | TP2 " + f_px(tT2) + " | " + str.tostring(lots, "0.00") + " lot × 2 orders, risk $" + str.tostring(riskUsd, "0.00") + (minLot ? " (min lot)" : "")
    if todayKey != tdayKey
        todayKey := tdayKey
        todayN := 0
    todayN += 1
    if not showPast
        line.delete(lnE)
        line.delete(lnSL)
        line.delete(lnT1)
        line.delete(lnT2)
        label.delete(lbSig)
        label.delete(lbRes)
    int x2 = bar_index + HOLD_BARS
    lbSig := label.new(bar_index, sigDir == 1 ? low : high, side, style = sigDir == 1 ? label.style_label_up : label.style_label_down, color = sigDir == 1 ? C_BUY : C_SELL, textcolor = color.white, size = size.normal)
    lnE  := line.new(bar_index, close, x2, close, color = color.new(C_TXT, 60), style = line.style_dotted)
    lnSL := line.new(bar_index, tSL, x2, tSL, color = C_SL, width = 2)
    lnT1 := line.new(bar_index, tT1, x2, tT1, color = C_TP, width = 1, style = line.style_dashed)
    lnT2 := line.new(bar_index, tT2, x2, tT2, color = C_TP, width = 2)
    fRisk := linefill.new(lnE, lnSL, color.new(C_SL, 88))
    fGain := linefill.new(lnE, lnT2, color.new(C_TP, 90))
    lbSL := label.new(x2, tSL, "SL " + f_px(tSL), style = label.style_label_left, color = C_SL, textcolor = color.white, size = size.small)
    lbT1 := label.new(x2, tT1, "TP1 " + f_px(tT1), style = label.style_label_left, color = color.new(C_TP, 30), textcolor = color.black, size = size.small)
    lbT2 := label.new(x2, tT2, "TP2 " + f_px(tT2), style = label.style_label_left, color = C_TP, textcolor = color.black, size = size.small)

// ─── Alerts: create one alert with "Any alert() function call" ──────────────
if newSig
    alert(sigTxt, alert.freq_once_per_bar_close)
if cancelNow and active
    alert("❄ " + evt, alert.freq_once_per_bar)
if evt != "" and barstate.isconfirmed and active and not cancelNow
    alert("❄ XAUUSD · " + evt, alert.freq_once_per_bar_close)

// ─── Panel (3 rows) ───────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 3, bgcolor = color.new(C_BG, 10), border_width = 0)
if barstate.islast
    if not active
        table.cell(dash, 0, 0, "❄ FROSTBITE", text_color = C_TXT, text_size = size.small)
        table.cell(dash, 1, 0, "XAUUSD · M5 only", text_color = C_SL, text_size = size.small)
    else
        string now = tDir == 0 ? "waiting" : (tDir == 1 ? "BUY" : "SELL") + (pend ? " · enter now" : gotT1 ? " · TP1 ✓" : " · open")
        table.cell(dash, 0, 0, "❄ FROSTBITE", text_color = C_TXT, text_size = size.small)
        table.cell(dash, 1, 0, now, text_color = tDir == 1 ? C_BUY : tDir == -1 ? C_SELL : C_TXT, text_size = size.small)
        table.cell(dash, 0, 1, "Lots", text_color = C_TXT, text_size = size.small)
        table.cell(dash, 1, 1, tDir == 0 ? "—" : str.tostring(tLots, "0.00") + " × 2", text_color = C_TXT, text_size = size.small)
        table.cell(dash, 0, 2, "Today", text_color = C_TXT, text_size = size.small)
        table.cell(dash, 1, 2, str.tostring(todayKey == tdayKey ? todayN : 0) + " signals · chart avg " + (nTr > 0 ? str.tostring(sumR / nTr, "+0.00;-0.00") + "R" : "—"), text_color = C_TXT, text_size = size.small)
